# ==========================================
# InfantCareAssist - Project .gitignore
# ==========================================

# Git metadata backups
.git_backups/

# Node dependencies
node_modules/
*/node_modules/
*/*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments & packages
venv/
.venv/
*/venv/
*/.venv/
*/*/venv/
*/*/.venv/
env/
ENV/
*.pyc
*.pyo
*.pyd
__pycache__/
*/__pycache__/
*/*/__pycache__/

# Android build outputs & caches
android/app/build/
android/.gradle/
android/.kotlin/
android/app/.cxx/
*/android/app/build/
*/android/.gradle/
*/android/.kotlin/
*/android/app/.cxx/
*/*/android/app/build/
*/*/android/.gradle/
*/*/android/app/.cxx/
*.apk
*.aab

# iOS build outputs & caches
ios/build/
ios/Pods/
*/ios/build/
*/ios/Pods/

# Expo & Metro
.expo/
*/.expo/
*/*/.expo/
.metro/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.template
*/.env
*/*/.env
*/*/backend/.env

# Large archives and binary installers
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.exe

# IDE & Editor caches
.idea/
.vscode/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
